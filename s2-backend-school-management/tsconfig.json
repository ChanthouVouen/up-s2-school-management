{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "app.ts",
    "config/**/*.ts",
    "bin/**/*.ts",
    "routes/**/*.ts",
    "controllers/**/*.ts",
    "middlewares/**/*.ts",
    "lib/**/*.ts",
    "utils/**/*.ts",
    "types/**/*.ts",
    "prisma/**/*.ts",
    "validations/**/*.ts"
  ]
}