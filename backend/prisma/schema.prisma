generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StudentStatus {
  ENROLLED
  PENDING
  GRADUATED
  SUSPENDED
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum ApplicationStatus {
  REGISTRATION
  DOCUMENT_SUBMISSION
  DOCUMENT_REVIEW
  DOCUMENTS_APPROVED
  SCHOLARSHIP_APPLICATION
  APPLICATION_SUBMITTED
  SCHOOL_REVIEW
  SCHOOL_APPROVED
  PAYMENT
  ENROLLED
  PENDING
  APPROVED
  REJECTED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  DIPLOMA
  ID
  TRANSCRIPT
  CERTIFICATE
  OTHER
}

enum ActivityType {
  STUDENT
  TEACHER
  DOCUMENT
  APPLICATION
  PAYMENT
  USER
  ROLE
  SYSTEM
  PARTNER_SCHOOL
}

enum PartnerType {
  HIGH_SCHOOL
  UNIVERSITY
  COMPANY
  ORGANIZATION
}

enum PartnerSchoolStatus {
  ACTIVE
  INACTIVE
  PENDING_RENEWAL
  EXPIRED
}

enum MouStatus {
  ACTIVE
  EXPIRED
  PENDING_RENEWAL
  TERMINATED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
  permissions Permission[] @relation("RolePermissions") 

  @@map("roles")
}

model Permission {
  id    String @id @default(uuid())
  name  String @unique // e.g., "post:create", "post:delete"
  roles Role[] @relation("RolePermissions")

  @@map("permissions")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  applications Application[] @relation("ApplicationResponsibleStaff")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("blacklisted_tokens")
}

model Student {
  id              Int              @id @default(autoincrement())
  studentCode     String           @unique
  name            String
  email           String?
  phone           String?
  gender          String?
  dob             DateTime?
  address         String?
  status          StudentStatus    @default(ENROLLED)
  paymentStatus   PaymentStatus    @default(UNPAID)
  department      String?
  partnerSchoolId Int?
  partnerSchool   PartnerSchool?   @relation(fields: [partnerSchoolId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  applications    Application[]
  documents       Document[]
  histories       StudentHistory[]

  @@map("students")
}

model StudentHistory {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  action      String
  description String
  performedBy String?  @default("Admin")
  createdAt   DateTime @default(now())

  @@map("student_histories")
}

model Application {
  id                  Int               @id @default(autoincrement())
  applicantName       String
  email               String
  program             String
  applicationDate     DateTime          @default(now())
  status              ApplicationStatus @default(REGISTRATION)
  studentId           Int?
  student             Student?          @relation(fields: [studentId], references: [id])
  partnerSchoolId     Int?
  partnerSchool       PartnerSchool?    @relation(fields: [partnerSchoolId], references: [id])
  responsibleStaffId  String?
  responsibleStaff    User?             @relation("ApplicationResponsibleStaff", fields: [responsibleStaffId], references: [id], onDelete: SetNull)
  scholarshipRequested Boolean           @default(false)
  scholarshipDetails  String?           @db.Text
  notes               String?           @db.Text
  approvalResult      String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("applications")
}

model Document {
  id        Int            @id @default(autoincrement())
  title     String
  type      DocumentType   @default(OTHER)
  status    DocumentStatus @default(PENDING)
  studentId Int?
  student   Student?       @relation(fields: [studentId], references: [id])
  createdAt DateTime       @default(now())

  @@map("documents")
}

model ActivityLog {
  id          Int           @id @default(autoincrement())
  title       String
  description String
  type        ActivityType?
  createdAt   DateTime      @default(now())

  @@map("activity_logs")
}

model PartnerSchool {
  id            Int                 @id @default(autoincrement())
  name          String
  type          PartnerType         @default(HIGH_SCHOOL)
  city          String?
  address       String?
  website       String?
  logoUrl       String?
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  status        PartnerSchoolStatus @default(ACTIVE)
  notes         String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  students      Student[]
  mous          Mou[]
  applications  Application[]

  @@map("partner_schools")
}

model Mou {
  id                  Int          @id @default(autoincrement())
  partnerSchoolId     Int
  partnerSchool       PartnerSchool @relation(fields: [partnerSchoolId], references: [id], onDelete: Cascade)
  mouTitle            String
  mouNumber           String?
  signDate            DateTime
  startDate           DateTime
  endDate             DateTime
  status              MouStatus    @default(ACTIVE)
  discountType        DiscountType @default(PERCENTAGE)
  discountValue       Float        @default(0)
  maxEligibleStudents Int?
  mouDocumentUrl      String?
  scope               String?      @db.Text
  notes               String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("mous")
}

model OrganizationSetting {
  id            Int      @id @default(1)
  orgName       String   @default("")
  slogan        String?
  logoUrl       String?  @db.LongText
  primaryEmail  String?
  supportPhone  String?
  websiteUrl    String?
  supportPortal String?
  streetAddress String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  updatedAt     DateTime @updatedAt

  @@map("organization_settings")
}
